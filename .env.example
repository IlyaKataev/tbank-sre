# Generate local values with: make env
# Do not commit .env. Keep credentials stable between restarts.
# POSTGRES_PASSWORD must be URI-safe (the generator uses hexadecimal characters).
POSTGRES_PASSWORD=
JWT_SECRET=
APP_PORT=8080
LOG_LEVEL=info
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
ORDER_RATE_LIMIT_MINUTES=1
